{
  "name": "quickmock",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Lo-fi, pen-and-ink flow prototypes driven by an agent over MCP. One spec, two views: a board of every screen state and a working prototype.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:migrate && next build",
    "start": "next start",
    "db:migrate": "tsx scripts/migrate.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.4",
    "@fontsource/architects-daughter": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/reenie-beanie": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ioredis": "^6.1.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "roughjs": "^4.6.6",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
